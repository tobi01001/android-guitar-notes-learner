<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#F5F5F5"
                android:endColor="#E8E8E8"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Subtle fretboard lines - horizontal strings -->
    <item android:top="20dp" android:left="20dp" android:right="20dp">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#E0E0E0" />
        </shape>
    </item>
    
    <item android:top="40dp" android:left="20dp" android:right="20dp">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#E0E0E0" />
        </shape>
    </item>
</layer-list>
