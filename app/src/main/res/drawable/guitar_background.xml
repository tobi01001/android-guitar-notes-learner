<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark atmospheric background matching guitar fretboard image -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#1A1A1A"
                android:endColor="#0D0D0D"
                android:startColor="#262626"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Subtle vignette effect to darken edges -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#00000000"
                android:endColor="#99000000"
                android:startColor="#99000000"
                android:type="radial"
                android:gradientRadius="800dp"
                android:centerX="0.5"
                android:centerY="0.4" />
        </shape>
    </item>
</layer-list>
